# Copy to .env (scripts/setup.ps1 does this and generates STORAGE_SECRET). Never commit .env.

# --- required ---
STORAGE_SECRET=change-me
ADMIN_USERNAME=admin
# Only used on first start to create the admin account; remove it from .env afterwards.
ADMIN_PASSWORD=

# --- server ---
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
SESSION_HOURS=8
# Set true when served over HTTPS (CloudFront/ALB) - secure cookies + HSTS
HTTPS_ONLY_COOKIES=false

# --- model provider: extractive (offline, free) | openai | anthropic | bedrock ---
LLM_PROVIDER=extractive
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# bedrock uses the standard AWS credential chain (named profile / SSO) - no keys in this file
AWS_REGION=us-east-1

# --- limits ---
MAX_UPLOAD_MB=10
MAX_DOCS_PER_USER=50
DAILY_QUESTION_QUOTA=200
MAX_CONCURRENT_LLM=4
DELETE_ORIGINALS=true
